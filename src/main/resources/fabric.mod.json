{
  "schemaVersion": 1,
  "id": "bettersilktouch",
  "version": "${version}",
  "name": "Better Silk Touch",
  "description": "Stops you from breaking configured blocks unless your tool has Silk Touch.",
  "authors": [
    "flodlol"
  ],
  "contact": {
    "homepage": "https://github.com/flodlol/bettersilktouch-minecraft",
    "sources": "https://github.com/flodlol/bettersilktouch-minecraft",
    "issues": "https://github.com/flodlol/bettersilktouch-minecraft/issues"
  },
  "license": "GPL-2.0",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.flodlol.bettersilktouch.client.BetterSilkTouchClient"
    ],
    "modmenu": [
      "dev.flodlol.bettersilktouch.client.ModMenuCompat"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
